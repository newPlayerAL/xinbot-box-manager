[Unit]
Description=XinBot Box Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xinbot
Group=xinbot
WorkingDirectory=/var/lib/xinbot-box-manager
EnvironmentFile=-/etc/default/xinbot-box-manager
ExecStart=/usr/bin/xinbot-box-manager serve
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xinbot-box-manager

[Install]
WantedBy=multi-user.target
