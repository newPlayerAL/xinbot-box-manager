[Unit]
Description=XinBot Box Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xinbot
Group=xinbot
WorkingDirectory=/var/lib/xinbot-box-manager
EnvironmentFile=-/etc/default/xinbot-box-manager
ExecStart=/usr/bin/xinbot-box-manager serve
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xinbot-box-manager

# 在 2 GB 设备上完成实机测试后，可以考虑启用整个服务 cgroup 的保护上限。
# MemoryMax=1700M

[Install]
WantedBy=multi-user.target
