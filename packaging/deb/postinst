#!/bin/sh
set -e

if ! getent group xinbot >/dev/null 2>&1; then
    addgroup --system xinbot
fi

if ! getent passwd xinbot >/dev/null 2>&1; then
    adduser \
        --system \
        --ingroup xinbot \
        --home /var/lib/xinbot-box-manager \
        --no-create-home \
        --disabled-login \
        --gecos "XinBot Box Manager" \
        xinbot
fi

install -d -o xinbot -g xinbot -m 0700 /var/lib/xinbot-box-manager
install -d -o xinbot -g xinbot -m 0700 /var/lib/xinbot-box-manager/resources
for resource in \
    catalog.json \
    xinbot.jar \
    xinmetaplugin.jar \
    backtothebase.jar \
    movementsync.jar
do
    install \
        -o xinbot \
        -g xinbot \
        -m 0644 \
        "/usr/share/xinbot-box-manager/resources/$resource" \
        "/var/lib/xinbot-box-manager/resources/$resource"
done

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable xinbot-box-manager.service >/dev/null
    systemctl restart xinbot-box-manager.service
fi

exit 0
